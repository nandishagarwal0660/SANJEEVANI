# ─────────────────────────────────────────────────────────────────
# SANJEEVANI — Environment Variables Template
# Copy this file to .env.local and fill in your keys.
# ─────────────────────────────────────────────────────────────────

# ── MedGemma-27B via Hugging Face Inference API ───────────────────
# Get your token at: https://huggingface.co/settings/tokens
# You must first request access to: https://huggingface.co/google/medgemma-27b-it
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Gemini fallback (used if HF Inference is unavailable) ────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Maps Platform ─────────────────────────────────────────
# Enable these APIs in Google Cloud Console:
#   - Maps JavaScript API
#   - Places API (New)
#   - Directions API
#   - Distance Matrix API
# Restrict your key to your domain in production!
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── (Optional) MongoDB — for storing triage records ──────────────
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sanjeevani
